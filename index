<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>فك رمز DOT — تاريخ تصنيع الكفر</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet">
<style>
  :root{
    --asphalt: #17181A;
    --asphalt-2: #1f2022;
    --rubber: #2b2c2f;
    --rubber-light: #3a3b3e;
    --chalk: #F2EEE6;
    --chalk-dim: #ADA99E;
    --safety: #FF5A1F;
    --safety-dim: #cf4a17;
    --tread-line: #ffffff12;
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    background:var(--asphalt);
    color:var(--chalk);
    font-family:'Tajawal', sans-serif;
    min-height:100vh;
    display:flex;
    flex-direction:column;
    align-items:center;
    padding:0 0 60px;
  }
  /* tire tread top bar */
  .tread{
    width:100%;
    height:14px;
    background:repeating-linear-gradient(
      -35deg,
      var(--asphalt-2) 0 10px,
      #0e0f10 10px 20px
    );
    border-bottom:2px solid var(--safety);
  }
  header{
    width:100%;
    max-width:640px;
    padding:38px 24px 10px;
    text-align:center;
  }
  .eyebrow{
    font-family:'Cairo', sans-serif;
    font-weight:700;
    letter-spacing:.5px;
    color:var(--safety);
    font-size:13px;
    text-transform:uppercase;
  }
  h1{
    font-family:'Cairo', sans-serif;
    font-weight:900;
    font-size:clamp(28px, 6vw, 42px);
    margin:8px 0 6px;
    color:var(--chalk);
  }
  .sub{
    color:var(--chalk-dim);
    font-size:15px;
    line-height:1.8;
    max-width:480px;
    margin:0 auto;
  }
  .sub b{color:var(--chalk);}

  main{
    width:100%;
    max-width:640px;
    padding:20px 24px;
  }

  /* DOT sidewall strip */
  .strip{
    background:var(--rubber);
    border-radius:14px;
    padding:22px 20px;
    box-shadow: inset 0 0 0 1px #ffffff0d, 0 20px 40px -20px #000a;
    position:relative;
    overflow:hidden;
  }
  .strip::before{
    content:"";
    position:absolute; inset:0;
    background:repeating-linear-gradient(90deg, var(--tread-line) 0 2px, transparent 2px 16px);
    opacity:.5;
    pointer-events:none;
  }
  .strip-label{
    font-family:'Cairo', sans-serif;
    font-size:12px;
    font-weight:700;
    color:var(--chalk-dim);
    letter-spacing:1px;
    margin-bottom:12px;
    text-align:center;
  }
  .digits-row{
    display:flex;
    justify-content:center;
    gap:10px;
    direction:ltr;
  }
  .digit-box{
    width:58px;
    height:70px;
    background:var(--asphalt);
    border:2px solid #ffffff14;
    border-radius:10px;
    display:flex;
    align-items:center;
    justify-content:center;
    font-family:'Cairo', sans-serif;
    font-weight:900;
    font-size:32px;
    color:var(--chalk);
    outline:none;
    text-align:center;
    transition:border-color .2s, transform .15s;
  }
  .digit-box:focus{
    border-color:var(--safety);
    transform:translateY(-2px);
  }
  .digit-hint{
    display:flex;
    justify-content:center;
    gap:10px;
    direction:ltr;
    margin-top:8px;
  }
  .digit-hint span{
    width:58px;
    text-align:center;
    font-size:11px;
    color:var(--chalk-dim);
    font-family:'Cairo', sans-serif;
  }

  .example-btn{
    display:block;
    margin:16px auto 0;
    background:none;
    border:none;
    color:var(--safety);
    font-family:'Tajawal', sans-serif;
    font-size:13px;
    text-decoration:underline;
    cursor:pointer;
  }

  /* Results */
  .results{
    margin-top:28px;
    display:none;
  }
  .results.show{display:block;}

  .gauge-wrap{
    display:flex;
    align-items:center;
    gap:20px;
    background:var(--rubber);
    border-radius:14px;
    padding:20px;
    margin-bottom:16px;
  }
  .gauge{
    flex-shrink:0;
  }
  .gauge-text{
    flex:1;
  }
  .gauge-num{
    font-family:'Cairo', sans-serif;
    font-weight:900;
    font-size:15px;
    color:var(--chalk);
    line-height:1.6;
  }
  .gauge-num b{color:var(--safety);}

  .cards{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:12px;
  }
  .card{
    background:var(--rubber);
    border-radius:12px;
    padding:16px 18px;
    border-inline-start:3px solid var(--safety);
  }
  .card-label{
    font-family:'Cairo', sans-serif;
    font-size:12px;
    font-weight:700;
    color:var(--chalk-dim);
    letter-spacing:.5px;
    margin-bottom:6px;
  }
  .card-value{
    font-family:'Cairo', sans-serif;
    font-size:19px;
    font-weight:700;
    color:var(--chalk);
  }

  .age-note{
    margin-top:14px;
    text-align:center;
    font-size:13px;
    color:var(--chalk-dim);
    line-height:1.9;
  }
  .age-note b{color:var(--chalk);}
  .warn{color:var(--safety); font-weight:700;}

  .error-box{
    display:none;
    margin-top:16px;
    background:#3a1f16;
    border:1px solid var(--safety-dim);
    color:#ffcbb0;
    border-radius:10px;
    padding:12px 16px;
    font-size:14px;
    text-align:center;
  }
  .error-box.show{display:block;}

  footer{
    margin-top:30px;
    color:var(--chalk-dim);
    font-size:12px;
    text-align:center;
    padding:0 24px;
  }

  @media (max-width:380px){
    .digit-box{width:48px; height:60px; font-size:26px;}
    .digit-hint span{width:48px;}
  }
</style>
</head>
<body>

<div class="tread"></div>

<header>
  <div class="eyebrow">DOT DECODER</div>
  <h1>تاريخ تصنيع الكفر</h1>
  <p class="sub">دور على آخر <b>٤ أرقام</b> من رمز DOT المطبوع على جنب الكفر، وحطها هنا. الرقمين الأولين هم رقم الأسبوع، والرقمين الأخيرين هم السنة.</p>
</header>

<main>
  <div class="strip">
    <div class="strip-label">أدخل الأرقام الأربعة</div>
    <div class="digits-row">
      <input class="digit-box" maxlength="1" inputmode="numeric" data-i="0">
      <input class="digit-box" maxlength="1" inputmode="numeric" data-i="1">
      <input class="digit-box" maxlength="1" inputmode="numeric" data-i="2">
      <input class="digit-box" maxlength="1" inputmode="numeric" data-i="3">
    </div>
    <div class="digit-hint">
      <span>أسبوع</span><span>أسبوع</span><span>سنة</span><span>سنة</span>
    </div>
  </div>

  <button class="example-btn" id="exampleBtn">جرب مثال (٢٣١٨)</button>

  <div class="error-box" id="errorBox">رقم الأسبوع غير صحيح — لازم يكون بين ٠١ و ٥٣</div>

  <div class="results" id="results">
    <div class="gauge-wrap">
      <svg class="gauge" width="86" height="86" viewBox="0 0 86 86">
        <circle cx="43" cy="43" r="36" fill="none" stroke="#ffffff14" stroke-width="9"/>
        <circle id="gaugeArc" cx="43" cy="43" r="36" fill="none" stroke="#FF5A1F" stroke-width="9"
                stroke-linecap="round" stroke-dasharray="226" stroke-dashoffset="226"
                transform="rotate(-90 43 43)"/>
        <text id="gaugeWeekText" x="43" y="49" text-anchor="middle" font-family="Cairo" font-weight="900" font-size="22" fill="#F2EEE6">0</text>
      </svg>
      <div class="gauge-text">
        <div class="gauge-num">أسبوع <b id="weekOut">-</b> من السنة — يعني تقريباً <span id="monthOut">-</span></div>
      </div>
    </div>

    <div class="cards">
      <div class="card">
        <div class="card-label">السنة</div>
        <div class="card-value" id="yearOut">-</div>
      </div>
      <div class="card">
        <div class="card-label">الأسبوع</div>
        <div class="card-value" id="weekOut2">-</div>
      </div>
      <div class="card">
        <div class="card-label">التاريخ التقريبي</div>
        <div class="card-value" id="dateOut">-</div>
      </div>
      <div class="card">
        <div class="card-label">اليوم</div>
        <div class="card-value" id="dayOut">-</div>
      </div>
    </div>

    <div class="age-note" id="ageNote"></div>
  </div>
</main>

<footer>الأرقام الأربعة الأخيرة من رمز DOT فقط تكفي لمعرفة أسبوع وسنة الصنع.</footer>

<script>
const boxes = [...document.querySelectorAll('.digit-box')];
const results = document.getElementById('results');
const errorBox = document.getElementById('errorBox');

const dayNames = ['الأحد','الاثنين','الثلاثاء','الأربعاء','الخميس','الجمعة','السبت'];
const monthNames = ['يناير','فبراير','مارس','أبريل','مايو','يونيو','يوليو','أغسطس','سبتمبر','أكتوبر','نوفمبر','ديسمبر'];

boxes.forEach((box, idx) => {
  box.addEventListener('input', () => {
    box.value = box.value.replace(/[^0-9]/g, '').slice(0,1);
    if (box.value && idx < boxes.length - 1) boxes[idx+1].focus();
    compute();
  });
  box.addEventListener('keydown', (e) => {
    if (e.key === 'Backspace' && !box.value && idx > 0) boxes[idx-1].focus();
  });
});

document.getElementById('exampleBtn').addEventListener('click', () => {
  const digits = ['2','3','1','8'];
  boxes.forEach((b,i) => b.value = digits[i]);
  compute();
});

function compute(){
  const vals = boxes.map(b => b.value);
  if (vals.some(v => v === '')){
    results.classList.remove('show');
    errorBox.classList.remove('show');
    return;
  }
  const week = parseInt(vals[0]+vals[1], 10);
  const yy = parseInt(vals[2]+vals[3], 10);
  const year = 2000 + yy;

  if (week < 1 || week > 53){
    results.classList.remove('show');
    errorBox.classList.add('show');
    return;
  }
  errorBox.classList.remove('show');

  // Tire DOT week counting: week 1 = first week containing Jan 1 (Sunday-based, common industry convention)
  // We'll compute using ISO-ish: Jan 1 + (week-1)*7 days as a close, practical approximation.
  const jan1 = new Date(Date.UTC(year, 0, 1));
  const dayOfWeek = jan1.getUTCDay(); // 0 = Sunday
  const firstSunday = new Date(jan1);
  firstSunday.setUTCDate(jan1.getUTCDate() - dayOfWeek);
  const targetDate = new Date(firstSunday);
  targetDate.setUTCDate(firstSunday.getUTCDate() + (week - 1) * 7);

  const dayName = dayNames[targetDate.getUTCDay()];
  const dd = targetDate.getUTCDate();
  const mm = targetDate.getUTCMonth();
  const monthName = monthNames[mm];
  const dateStr = `${dd} ${monthName} ${year}`;

  document.getElementById('yearOut').textContent = year;
  document.getElementById('weekOut2').textContent = 'الأسبوع ' + week;
  document.getElementById('dateOut').textContent = dateStr;
  document.getElementById('dayOut').textContent = dayName;
  document.getElementById('weekOut').textContent = week;
  document.getElementById('monthOut').textContent = monthName;

  // gauge
  const circumference = 226;
  const pct = Math.min(week / 53, 1);
  document.getElementById('gaugeArc').setAttribute('stroke-dashoffset', circumference - pct * circumference);
  document.getElementById('gaugeWeekText').textContent = week;

  // age note
  const now = new Date();
  const ageMonths = (now.getFullYear() - year) * 12 + (now.getMonth() - mm);
  const ageYears = (ageMonths / 12).toFixed(1);
  const ageNote = document.getElementById('ageNote');
  if (ageMonths < 0){
    ageNote.innerHTML = `هذا التاريخ في المستقبل — تأكد من الأرقام.`;
  } else {
    let warnHtml = '';
    if (ageMonths >= 72) {
      warnHtml = ` — <span class="warn">عمره فوق ٦ سنوات، يفضل فحصه أو تغييره حتى لو الشكل ممتاز</span>`;
    }
    ageNote.innerHTML = `عمر الكفر تقريباً <b>${ageYears} سنة</b>${warnHtml}`;
  }

  results.classList.add('show');
}
</script>

</body>
</html>
